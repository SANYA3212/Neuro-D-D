# --- Gemini AI Configuration ---
# You can get a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="__PUT_YOUR_KEY_HERE__"

# The model to use for the AI Dungeon Master.
# "gemini-1.5-flash" is recommended for its balance of speed and capability.
# Other options include "gemini-1.5-pro" for higher quality responses.
GEMINI_MODEL="gemini-1.5-flash"

# --- Security (Optional - for development, defaults are fine) ---
# SECRET_KEY="a_custom_secret_key_for_jwt"
# PASSWORD_SALT="a_custom_salt_for_passwords"
